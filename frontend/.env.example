# KAALVAN Frontend Environment Variables
# -------------------------------------------------------------
# 1. CARTO Basemap API Key (Optional)
# If left empty, KAALVAN automatically uses high-contrast Dark Gray Canvas tiles.
# Get a free key at: https://carto.com/basemaps/apikey or https://carto.com/signup
VITE_CARTO_API_KEY=""

# 2. Cesium Ion Access Token (Optional)
# For Cesium Ion 3D world terrain and Sentinel-2 satellite overlays.
# Get a free personal token at: https://ion.cesium.com/tokens
VITE_CESIUM_ION_TOKEN=""

# 3. Backend API Base URL
VITE_API_BASE_URL="http://127.0.0.1:8000"
