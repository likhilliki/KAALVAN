# ==============================================================================
# TerraGuard AI Environment Configuration - IBM LinuxONE Datathon
# ==============================================================================

PROJECT_NAME="TerraGuard AI"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"

# Database Configuration (PostgreSQL/PostGIS for LinuxONE, SQLite for local dev)
# For production PostgreSQL / PostGIS on LinuxONE:
# DATABASE_URL="postgresql+psycopg2://terraguard:terraguard_secure_pass@localhost:5432/terraguard_db"
DATABASE_URL="sqlite:///./terraguard.db"

# NASA FIRMS API Map Key
# Get a free key at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# If blank, TerraGuard AI gracefully falls back to authentic live CSV feeds and regional caches.
NASA_FIRMS_MAP_KEY=""

# Open-Meteo Weather & Air Quality APIs (No key required for non-commercial research)
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1"
OPEN_METEO_AIR_QUALITY_URL="https://air-quality-api.open-meteo.com/v1"

# Cache TTL in seconds (10 minutes)
CACHE_TTL_SECONDS=600

# CORS origins (comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000,*"

# IBM LinuxONE Architecture Telemetry Flag
LINUXONE_TELEMETRY=true
